{
  "name": "hubbub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build --concurrency=5",
    "dev": "turbo run dev --concurrency=5",
    "dev:all": "turbo run dev --concurrency=5 --filter=@hubbub/server --filter=@hubbub/web --filter=@hubbub/screen --filter=@hubbub/controller",
    "dev:games:on": "node packages/games-manifest/scripts/generate.mjs --dev-games=on",
    "dev:games:off": "node packages/games-manifest/scripts/generate.mjs --dev-games=off",
    "typecheck": "turbo run typecheck --concurrency=5",
    "test": "turbo run generate --concurrency=5 && vitest run && pnpm run test:worker",
    "test:worker": "pnpm --filter @hubbub/worker test",
    "host:build": "turbo run build --concurrency=5 --filter=@hubbub/host-desktop",
    "host:dev": "turbo run build --concurrency=5 --filter=@hubbub/screen --filter=@hubbub/controller && pnpm --filter @hubbub/host-desktop build && pnpm --filter @hubbub/host-desktop dev",
    "host:package": "pnpm host:build && pnpm --filter @hubbub/host-desktop package",
    "dev:sandbox:on": "node packages/games-manifest/scripts/sandbox-mode.mjs on",
    "dev:sandbox:off": "node packages/games-manifest/scripts/sandbox-mode.mjs off",
    "dev:sandbox": "turbo run dev --concurrency=5 --filter=@hubbub/server --filter=@hubbub/web --filter=@hubbub/sandbox-app"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "undici@<7.29.0": ">=7.29.0",
      "tar@<7.5.21": ">=7.5.21",
      "js-yaml@<4.3.1": ">=4.3.1 <5.0.0",
      "fast-uri@<3.1.5": ">=3.1.5 <4.0.0",
      "brace-expansion@>=1.0.0 <1.1.18": ">=1.1.18 <2.0.0",
      "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4 <3.0.0",
      "brace-expansion@>=5.0.0 <5.0.9": ">=5.0.9 <6.0.0",
      "postcss@<8.5.23": ">=8.5.23 <9.0.0",
      "nanoid@<3.3.18": ">=3.3.18 <4.0.0"
    },
    "onlyBuiltDependencies": [
      "workerd"
    ]
  }
}
