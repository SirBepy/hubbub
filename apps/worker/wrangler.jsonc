{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Name determines the workers.dev subdomain (https://hubbub.<account-subdomain>.workers.dev).
  "name": "hubbub",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  // Deploy fails until hubbub.tv is a zone on this Cloudflare account. Delete this block to fall
  // back to the workers.dev subdomain; the client reads its endpoint from the served origin.
  "routes": [
    { "pattern": "hubbub.tv", "custom_domain": true }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiterDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO", "RateLimiterDO"] }
  ]
}
