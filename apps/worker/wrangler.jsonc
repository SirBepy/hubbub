{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Name determines the workers.dev subdomain (https://hubbub.<account-subdomain>.workers.dev).
  "name": "hubbub",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  // No custom domain yet: served from the workers.dev subdomain. Adding one later means a
  // "routes" entry with custom_domain plus the zone on this account, and no code change.
  "workers_dev": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiterDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO", "RateLimiterDO"] }
  ]
}
