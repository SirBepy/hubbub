{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Name determines the workers.dev subdomain (https://hubbub.<account-subdomain>.workers.dev).
  "name": "hubbub",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  // The sirbepy.dev zone lives on this Cloudflare account (registered through Cloudflare
  // Registrar), so wrangler can attach the hostname itself; deploying before the zone exists
  // fails. workers_dev stays on as a fallback URL, but games do not load there: the sandbox CSP
  // only lets the custom-domain shell embed them (see .github/workflows/deploy.yml).
  "routes": [{ "pattern": "hubbub.sirbepy.dev", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiterDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO", "RateLimiterDO"] }
  ]
}
