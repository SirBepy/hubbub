{
  "$schema": "../worker/node_modules/wrangler/config-schema.json",
  // The games' sandbox origin: a SECOND Worker so the iframe's origin differs from the shell's
  // (packages/sandbox/src/shell.ts rejects a same-origin sandbox). Static assets only, no code:
  // the CSP and CORS headers come from dist/_headers, written by the sandbox vite build.
  "name": "hubbub-games",
  "compatibility_date": "2026-08-04",
  // A sibling host of the shell under the same zone, so the two stay distinct origins.
  "routes": [{ "pattern": "hubbub-games.sirbepy.dev", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // The shell requests frame.html by that exact name. The default html_handling 307s it to
    // /frame, which then misses the /frame.html no-cache rule in _headers.
    "html_handling": "none"
  }
}
