{
  "name": "@hubbub/games-manifest",
  "version": "0.0.0",
  "type": "module",
  "main": "./src/logics.ts",
  "types": "./src/logics.ts",
  "exports": {
    ".": "./src/logics.ts",
    "./lazy": "./src/lazy.ts",
    "./settings": "./src/settings.ts",
    "./sources": "./src/sources.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "postinstall": "node scripts/generate.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hubbub/sdk": "workspace:*",
    "@hubbub/protocol": "workspace:*",
    "@hubbub/game-tictactoe": "workspace:*",
    "@hubbub/game-ultimate-tictactoe": "workspace:*"
  },
  "optionalDependencies": {
    "@hubbub/game-tap-race": "link:../../../hubbub-game-tap-race",
    "@hubbub/game-music-guesser": "link:../../../hubbub-game-music-guesser",
    "@hubbub/game-split-opinions": "link:../../../hubbub-game-split-opinions",
    "@hubbub/game-sample": "link:../../../hubbub-game-template"
  },
  "peerDependencies": {
    "react": "^18.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "react": "^18.3.0",
    "@types/react": "^18.3.0",
    "@types/node": "^22.0.0"
  }
}
